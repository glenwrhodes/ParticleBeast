{
  "version": 1,
  "name": "Fireworks",
  "looping": false,
  "emitters": [
    {
      "name": "rockets",
      "duration": 1.4,
      "looping": false,
      "maxParticles": 8,
      "simulationSpace": "world",
      "gravity": 0.35,
      "emission": {
        "rateOverTime": 0,
        "bursts": [
          { "time": 0, "count": 1 },
          { "time": 0.45, "count": 1 },
          { "time": 0.9, "count": { "type": "random", "min": 1, "max": 2 } }
        ]
      },
      "shape": { "type": "cone", "angle": 14, "radius": 0.6 },
      "lifetime": { "type": "random", "min": 0.9, "max": 1.25 },
      "speed": { "type": "random", "min": 10, "max": 13 },
      "size": 0.22,
      "startColor": [1, 0.9, 0.7, 1],
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 0.95, 0.8] }, { "t": 1, "color": [1, 0.7, 0.35] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 0.85, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "subEmitters": [
        { "target": "burst", "trigger": "death", "count": 90, "inheritVelocity": 0.05 },
        { "target": "ring", "trigger": "death", "count": 40, "probability": 0.6 }
      ],
      "render": { "sprite": "../sprites/trace_06.png", "blend": "additive", "mode": "stretched", "stretchFactor": 0.045, "lengthScale": 2.2 }
    },
    {
      "name": "burst",
      "isSubEmitter": true,
      "maxParticles": 600,
      "simulationSpace": "world",
      "gravity": 0.45,
      "shape": { "type": "sphere", "radius": 0.05, "shell": true },
      "lifetime": { "type": "random", "min": 1, "max": 1.8 },
      "speed": { "type": "random", "min": 4.5, "max": 7.5 },
      "size": { "type": "random", "min": 0.1, "max": 0.18 },
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [
            { "t": 0, "color": [1, 0.45, 0.25] },
            { "t": 0.34, "color": [1, 0.85, 0.3] },
            { "t": 0.67, "color": [0.35, 0.9, 1] },
            { "t": 1, "color": [0.55, 1, 0.5] }
          ],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 0.7, "v": 0.7 }, { "t": 1, "v": 0 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 0.6, "alpha": 0.9 }, { "t": 1, "alpha": 0 }]
          }
        },
        "drag": { "coefficient": 1.6 }
      },
      "subEmitters": [{ "target": "twinkle", "trigger": "death", "count": 1, "probability": 0.25 }],
      "render": { "sprite": "../sprites/spark_07.png", "blend": "additive", "mode": "stretched", "stretchFactor": 0.03, "lengthScale": 1 }
    },
    {
      "name": "ring",
      "isSubEmitter": true,
      "maxParticles": 220,
      "simulationSpace": "world",
      "gravity": 0.25,
      "shape": { "type": "circle", "radius": 0.05, "shell": true },
      "lifetime": { "type": "random", "min": 0.9, "max": 1.3 },
      "speed": { "type": "random", "min": 6, "max": 6.6 },
      "size": 0.12,
      "startColor": [1, 1, 1, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 0.15 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }, { "t": 0.5, "color": [0.5, 0.8, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 0.7, "alpha": 0.8 }, { "t": 1, "alpha": 0 }]
          }
        },
        "drag": { "coefficient": 1.8 }
      },
      "render": { "sprite": "../sprites/circle_05.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "twinkle",
      "isSubEmitter": true,
      "maxParticles": 200,
      "simulationSpace": "world",
      "gravity": 0.15,
      "shape": { "type": "point" },
      "lifetime": { "type": "random", "min": 0.4, "max": 0.9 },
      "speed": 0.2,
      "size": { "type": "random", "min": 0.12, "max": 0.22 },
      "startColor": [1, 1, 0.9, 1],
      "modules": {
        "sizeOverLife": {
          "curve": { "keys": [{ "t": 0, "v": 0 }, { "t": 0.2, "v": 1 }, { "t": 0.5, "v": 0.25 }, { "t": 0.8, "v": 0.9 }, { "t": 1, "v": 0 }] }
        }
      },
      "render": { "sprite": "../sprites/star_05.png", "blend": "additive", "mode": "billboard" }
    }
  ]
}
