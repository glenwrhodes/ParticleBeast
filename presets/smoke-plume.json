{
  "version": 1,
  "name": "Smoke Plume",
  "looping": true,
  "emitters": [
    {
      "name": "plume",
      "duration": 1,
      "looping": true,
      "maxParticles": 160,
      "simulationSpace": "world",
      "emission": { "rateOverTime": 26 },
      "shape": { "type": "circle", "radius": 0.35 },
      "lifetime": { "type": "random", "min": 2.5, "max": 4.5 },
      "speed": { "type": "random", "min": 0.5, "max": 1.1 },
      "size": { "type": "random", "min": 0.7, "max": 1.3 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "angularVelocity": { "type": "random", "min": -30, "max": 30 },
      "startColor": [1, 1, 1, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.45 }, { "t": 1, "v": 2.4 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [
              { "t": 0, "color": [0.32, 0.31, 0.3 ] },
              { "t": 0.5, "color": [0.45, 0.45, 0.46] },
              { "t": 1, "color": [0.6, 0.6, 0.62] }
            ],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.12, "alpha": 0.75 }, { "t": 0.75, "alpha": 0.45 }, { "t": 1, "alpha": 0 }]
          }
        },
        "velocityOverLife": { "y": { "type": "curve", "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 1.9 }] }, "x": 0.35 },
        "turbulence": { "strength": 0.5, "frequency": 0.45, "scrollSpeed": 0.3 },
        "drag": { "coefficient": 0.6 }
      },
      "render": { "sprite": "../sprites/smoke_09.png", "blend": "alpha", "mode": "billboard" }
    },
    {
      "name": "base fire",
      "duration": 1,
      "looping": true,
      "maxParticles": 40,
      "emission": { "rateOverTime": 18 },
      "shape": { "type": "circle", "radius": 0.3 },
      "lifetime": { "type": "random", "min": 0.3, "max": 0.6 },
      "speed": { "type": "random", "min": 0.5, "max": 1 },
      "size": { "type": "random", "min": 0.35, "max": 0.65 },
      "startColor": [1, 1, 1, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.7 }, { "t": 0.4, "v": 1 }, { "t": 1, "v": 0.3 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [
              { "t": 0, "color": [1, 0.9, 0.6] },
              { "t": 0.5, "color": [1, 0.55, 0.15] },
              { "t": 1, "color": [0.85, 0.25, 0.05] }
            ],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.15, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/flame_03.png", "blend": "additive", "mode": "vertical" }
    },
    {
      "name": "embers",
      "duration": 1,
      "looping": true,
      "maxParticles": 30,
      "emission": { "rateOverTime": 5 },
      "shape": { "type": "circle", "radius": 0.3 },
      "lifetime": { "type": "random", "min": 1, "max": 2 },
      "speed": { "type": "random", "min": 0.5, "max": 1.2 },
      "size": { "type": "random", "min": 0.03, "max": 0.07 },
      "startColor": [1, 0.7, 0.3, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 0 }] } },
        "velocityOverLife": { "y": { "type": "curve", "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 2.2 }] } },
        "turbulence": { "strength": 1.2, "frequency": 1.3, "scrollSpeed": 1 }
      },
      "render": { "sprite": "../sprites/circle_05.png", "blend": "additive", "mode": "billboard" }
    }
  ]
}
