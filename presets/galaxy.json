{
  "version": 1,
  "name": "Galaxy Swirl",
  "looping": true,
  "emitters": [
    {
      "name": "stars",
      "position": [0, 1.8, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 700,
      "emission": { "rateOverTime": 110 },
      "shape": { "type": "circle", "radius": 2.6 },
      "lifetime": { "type": "random", "min": 3.5, "max": 6 },
      "speed": 0,
      "size": { "type": "random", "min": 0.03, "max": 0.11 },
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [
            { "t": 0, "color": [1, 1, 1] },
            { "t": 0.35, "color": [0.55, 0.75, 1] },
            { "t": 0.7, "color": [1, 0.85, 0.6] },
            { "t": 1, "color": [0.45, 0.95, 1] }
          ],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0 }, { "t": 0.15, "v": 1 }, { "t": 0.85, "v": 0.9 }, { "t": 1, "v": 0 }] } },
        "orbit": { "speed": { "type": "random", "min": 26, "max": 48 }, "axis": [0, 1, 0] },
        "vortex": { "strength": 0, "axis": [0, 1, 0], "radialPull": 0.06 }
      },
      "render": { "sprite": "../sprites/star_01.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "dust arms",
      "position": [0, 1.8, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 120,
      "emission": { "rateOverTime": 22 },
      "shape": { "type": "circle", "radius": 2.1 },
      "lifetime": { "type": "random", "min": 3, "max": 5 },
      "speed": 0,
      "size": { "type": "random", "min": 0.6, "max": 1.2 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [{ "t": 0, "color": [0.3, 0.5, 0.95] }, { "t": 1, "color": [0.2, 0.8, 0.95] }],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.4 }, { "t": 0.5, "v": 1 }, { "t": 1, "v": 0.5 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.3, "alpha": 0.22 }, { "t": 0.7, "alpha": 0.22 }, { "t": 1, "alpha": 0 }]
          }
        },
        "orbit": { "speed": { "type": "random", "min": 22, "max": 36 }, "axis": [0, 1, 0] }
      },
      "render": { "sprite": "../sprites/smoke_07.png", "blend": "additive", "mode": "horizontal" }
    },
    {
      "name": "core",
      "position": [0, 1.8, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 5,
      "emission": { "rateOverTime": 2 },
      "shape": { "type": "point" },
      "lifetime": 2,
      "speed": 0,
      "size": { "type": "random", "min": 1.5, "max": 1.8 },
      "startColor": [1, 0.92, 0.7, 0.8],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.9 }, { "t": 0.5, "v": 1.05 }, { "t": 1, "v": 0.9 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.4, "alpha": 1 }, { "t": 0.6, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/light_02.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "shooting stars",
      "position": [0, 1.8, 0],
      "duration": 1.5,
      "looping": true,
      "maxParticles": 12,
      "emission": { "rateOverTime": 2.5 },
      "shape": { "type": "circle", "radius": 1.4, "shell": true },
      "lifetime": { "type": "random", "min": 0.7, "max": 1.2 },
      "speed": { "type": "random", "min": 2, "max": 3.4 },
      "size": 0.09,
      "startColor": [1, 1, 0.9, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 0.2 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.2, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        },
        "vortex": { "strength": 120, "axis": [0, 1, 0] }
      },
      "render": { "sprite": "../sprites/trace_06.png", "blend": "additive", "mode": "stretched", "stretchFactor": 0.12, "lengthScale": 1.4 }
    }
  ]
}
