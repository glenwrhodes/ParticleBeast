{
  "version": 1,
  "name": "Healing Aura",
  "looping": true,
  "emitters": [
    {
      "name": "floor ring",
      "position": [0, 0.03, 0],
      "duration": 2,
      "looping": true,
      "maxParticles": 3,
      "emission": { "rateOverTime": 1 },
      "shape": { "type": "point" },
      "lifetime": 2.2,
      "speed": 0,
      "size": 2.6,
      "angularVelocity": 35,
      "startColor": [0.5, 1, 0.6, 1],
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.3, "alpha": 0.7 }, { "t": 0.7, "alpha": 0.7 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/magic_01.png", "blend": "additive", "mode": "horizontal" }
    },
    {
      "name": "motes",
      "duration": 1,
      "looping": true,
      "maxParticles": 90,
      "emission": { "rateOverTime": 26 },
      "shape": { "type": "circle", "radius": 1 },
      "lifetime": { "type": "random", "min": 1.4, "max": 2.6 },
      "speed": { "type": "random", "min": 0.05, "max": 0.25 },
      "size": { "type": "random", "min": 0.07, "max": 0.16 },
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [{ "t": 0, "color": [0.55, 1, 0.6] }, { "t": 0.6, "color": [0.8, 1, 0.7] }, { "t": 1, "color": [1, 0.95, 0.6] }],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0 }, { "t": 0.25, "v": 1 }, { "t": 0.75, "v": 0.8 }, { "t": 1, "v": 0 }] } },
        "velocityOverLife": { "y": { "type": "curve", "keys": [{ "t": 0, "v": 0.5 }, { "t": 1, "v": 1.1 }] } },
        "turbulence": { "strength": 0.3, "frequency": 1.2, "scrollSpeed": 0.5 }
      },
      "render": { "sprite": "../sprites/circle_05.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "crosses",
      "duration": 1,
      "looping": true,
      "maxParticles": 26,
      "emission": { "rateOverTime": 7 },
      "shape": { "type": "circle", "radius": 0.8 },
      "lifetime": { "type": "random", "min": 1.3, "max": 2 },
      "speed": 0,
      "size": { "type": "random", "min": 0.16, "max": 0.3 },
      "startColor": [0.65, 1, 0.7, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.2 }, { "t": 0.3, "v": 1 }, { "t": 1, "v": 0.8 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.3, "alpha": 1 }, { "t": 0.7, "alpha": 0.9 }, { "t": 1, "alpha": 0 }]
          }
        },
        "velocityOverLife": { "y": { "type": "curve", "keys": [{ "t": 0, "v": 0.7 }, { "t": 1, "v": 1.3 }] } }
      },
      "render": { "sprite": "../sprites/magic_04.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "soft glow",
      "position": [0, 0.9, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 4,
      "emission": { "rateOverTime": 2 },
      "shape": { "type": "point" },
      "lifetime": 1.8,
      "speed": 0,
      "size": 2.5,
      "startColor": [0.45, 1, 0.55, 0.3],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.9 }, { "t": 0.5, "v": 1.05 }, { "t": 1, "v": 0.9 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.4, "alpha": 1 }, { "t": 0.6, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/light_01.png", "blend": "additive", "mode": "billboard" }
    }
  ]
}
