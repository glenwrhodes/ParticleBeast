{
  "version": 1,
  "name": "Confetti Burst",
  "looping": false,
  "emitters": [
    {
      "name": "confetti",
      "duration": 0.25,
      "looping": false,
      "maxParticles": 260,
      "gravity": 0.55,
      "emission": { "rateOverTime": 0, "bursts": [{ "time": 0, "count": { "type": "random", "min": 130, "max": 170 } }] },
      "shape": { "type": "cone", "angle": 32, "radius": 0.15 },
      "randomizeDirection": 0.12,
      "lifetime": { "type": "random", "min": 1.6, "max": 3 },
      "speed": { "type": "random", "min": 6, "max": 11 },
      "size": { "type": "random", "min": 0.08, "max": 0.16 },
      "sizeY": { "type": "random", "min": 0.05, "max": 0.1 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "angularVelocity": { "type": "random", "min": -700, "max": 700 },
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [
            { "t": 0, "color": [1, 0.25, 0.35] },
            { "t": 0.2, "color": [1, 0.7, 0.15] },
            { "t": 0.4, "color": [1, 0.95, 0.3] },
            { "t": 0.6, "color": [0.3, 0.9, 0.45] },
            { "t": 0.8, "color": [0.25, 0.65, 1] },
            { "t": 1, "color": [0.9, 0.4, 0.9] }
          ],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 0.85, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        },
        "drag": { "coefficient": 1.6 },
        "turbulence": { "strength": 0.9, "frequency": 1, "scrollSpeed": 0.7 },
        "limitVelocity": { "speed": 3.5, "dampen": 0.35 }
      },
      "render": { "sprite": "../sprites/window_01.png", "blend": "alpha", "mode": "billboard" }
    },
    {
      "name": "streamers",
      "duration": 0.2,
      "looping": false,
      "maxParticles": 60,
      "gravity": 0.4,
      "emission": { "rateOverTime": 0, "bursts": [{ "time": 0, "count": { "type": "random", "min": 25, "max": 35 } }] },
      "shape": { "type": "cone", "angle": 26, "radius": 0.1 },
      "lifetime": { "type": "random", "min": 1.2, "max": 2.2 },
      "speed": { "type": "random", "min": 7, "max": 12 },
      "size": 0.07,
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [
            { "t": 0, "color": [1, 0.85, 0.25] },
            { "t": 0.5, "color": [0.4, 0.95, 1] },
            { "t": 1, "color": [1, 0.45, 0.65] }
          ],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 0.8, "alpha": 0.9 }, { "t": 1, "alpha": 0 }]
          }
        },
        "drag": { "coefficient": 1.3 },
        "turbulence": { "strength": 1.4, "frequency": 0.9, "scrollSpeed": 0.8 }
      },
      "render": { "sprite": "../sprites/trace_03.png", "blend": "alpha", "mode": "stretched", "stretchFactor": 0.04, "lengthScale": 1.6 }
    },
    {
      "name": "pop flash",
      "duration": 0.1,
      "looping": false,
      "maxParticles": 2,
      "emission": { "rateOverTime": 0, "bursts": [{ "time": 0, "count": 1 }] },
      "shape": { "type": "point" },
      "lifetime": 0.15,
      "speed": 0,
      "size": 1.6,
      "startColor": [1, 0.95, 0.8, 0.9],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.5 }, { "t": 1, "v": 1.2 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/flare_01.png", "blend": "additive", "mode": "billboard" }
    }
  ]
}
