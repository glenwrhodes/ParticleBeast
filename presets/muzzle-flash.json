{
  "version": 1,
  "name": "Muzzle Flash",
  "looping": false,
  "emitters": [
    {
      "name": "flash",
      "position": [0, 1.2, 0],
      "duration": 0.1,
      "looping": false,
      "maxParticles": 3,
      "emission": { "rateOverTime": 0, "bursts": [{ "time": 0, "count": 2 }] },
      "shape": { "type": "point" },
      "lifetime": 0.07,
      "speed": 0,
      "size": { "type": "random", "min": 1.4, "max": 1.9 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "startColor": [1, 0.9, 0.6, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.6 }, { "t": 0.4, "v": 1 }, { "t": 1, "v": 1.05 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 0.95] }, { "t": 1, "color": [1, 0.65, 0.25] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/muzzle_05.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "star",
      "position": [0, 1.2, 0],
      "duration": 0.1,
      "looping": false,
      "maxParticles": 2,
      "emission": { "rateOverTime": 0, "bursts": [{ "time": 0, "count": 1 }] },
      "shape": { "type": "point" },
      "lifetime": 0.09,
      "speed": 0,
      "size": 2.4,
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "startColor": [1, 0.95, 0.7, 1],
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/flare_01.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "sparks",
      "position": [0, 1.2, 0],
      "duration": 0.15,
      "looping": false,
      "maxParticles": 40,
      "gravity": 0.5,
      "emission": { "rateOverTime": 0, "bursts": [{ "time": 0, "count": { "type": "random", "min": 14, "max": 22 } }] },
      "shape": { "type": "sphere", "radius": 0.12, "shell": true },
      "randomizeDirection": 0.2,
      "lifetime": { "type": "random", "min": 0.15, "max": 0.45 },
      "speed": { "type": "random", "min": 4, "max": 9 },
      "size": { "type": "random", "min": 0.04, "max": 0.09 },
      "startColor": [1, 0.85, 0.45, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 0.1 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 0.95, 0.7] }, { "t": 1, "color": [1, 0.45, 0.1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 0.8, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        },
        "drag": { "coefficient": 3 }
      },
      "render": { "sprite": "../sprites/spark_04.png", "blend": "additive", "mode": "stretched", "stretchFactor": 0.05, "lengthScale": 1.5 }
    },
    {
      "name": "smoke puff",
      "position": [0, 1.2, 0],
      "duration": 0.2,
      "looping": false,
      "maxParticles": 12,
      "emission": { "rateOverTime": 0, "bursts": [{ "time": 0.02, "count": { "type": "random", "min": 4, "max": 7 } }] },
      "shape": { "type": "sphere", "radius": 0.15 },
      "randomizeDirection": 0.6,
      "lifetime": { "type": "random", "min": 0.6, "max": 1.2 },
      "speed": { "type": "random", "min": 0.5, "max": 1.5 },
      "size": { "type": "random", "min": 0.35, "max": 0.6 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "angularVelocity": { "type": "random", "min": -60, "max": 60 },
      "startColor": [0.55, 0.52, 0.5, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.6 }, { "t": 1, "v": 1.9 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.15, "alpha": 0.4 }, { "t": 1, "alpha": 0 }]
          }
        },
        "drag": { "coefficient": 2 }
      },
      "render": { "sprite": "../sprites/smoke_02.png", "blend": "alpha", "mode": "billboard", "applyTint": false }
    }
  ]
}
