{
  "version": 1,
  "name": "Portal",
  "looping": true,
  "emitters": [
    {
      "name": "rim",
      "position": [0, 1.6, 0],
      "rotation": [90, 0, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 260,
      "emission": { "rateOverTime": 120 },
      "shape": { "type": "circle", "radius": 1.35, "shell": true },
      "lifetime": { "type": "random", "min": 0.8, "max": 1.6 },
      "speed": 0.05,
      "size": { "type": "random", "min": 0.09, "max": 0.2 },
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [{ "t": 0, "color": [0.3, 1, 0.75] }, { "t": 1, "color": [0.15, 0.7, 1] }],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0 }, { "t": 0.25, "v": 1 }, { "t": 1, "v": 0 }] } },
        "vortex": { "strength": 160, "axis": [0, 1, 0] }
      },
      "render": { "sprite": "../sprites/spark_07.png", "blend": "additive", "mode": "stretched", "stretchFactor": 0.12, "lengthScale": 1.5 }
    },
    {
      "name": "swirl haze",
      "position": [0, 1.6, 0],
      "rotation": [90, 0, 0],
      "duration": 2,
      "looping": true,
      "maxParticles": 6,
      "emission": { "rateOverTime": 2 },
      "shape": { "type": "point" },
      "lifetime": 2.2,
      "speed": 0,
      "size": 2.7,
      "angularVelocity": -80,
      "startColor": [0.2, 0.85, 0.9, 0.8],
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.3, "alpha": 0.85 }, { "t": 0.7, "alpha": 0.85 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/twirl_03.png", "blend": "additive", "mode": "horizontal" }
    },
    {
      "name": "indraft",
      "position": [0, 1.6, 0],
      "rotation": [90, 0, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 180,
      "emission": { "rateOverTime": 70 },
      "shape": { "type": "circle", "radius": 2.6, "shell": true },
