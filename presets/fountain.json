{
  "version": 1,
  "name": "Fountain",
  "looping": true,
  "emitters": [
    {
      "name": "jets",
      "duration": 1,
      "looping": true,
      "maxParticles": 600,
      "simulationSpace": "world",
      "gravity": 1,
      "emission": { "rateOverTime": 260 },
      "shape": { "type": "cone", "angle": 9, "radius": 0.08 },
      "randomizeDirection": 0.03,
      "lifetime": { "type": "random", "min": 1.1, "max": 1.5 },
      "speed": { "type": "random", "min": 6.5, "max": 8 },
      "size": { "type": "random", "min": 0.05, "max": 0.11 },
      "startColor": [0.65, 0.82, 1, 0.8],
      "subEmitters": [{ "target": "splash", "trigger": "death", "count": 2, "probability": 0.4 }],
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }, { "t": 1, "color": [0.8, 0.92, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0.9 }, { "t": 0.85, "alpha": 0.7 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/trace_02.png", "blend": "additive", "mode": "stretched", "stretchFactor": 0.035, "lengthScale": 1.2 }
    },
    {
      "name": "splash",
      "isSubEmitter": true,
      "maxParticles": 400,
      "simulationSpace": "world",
      "gravity": 0.9,
      "shape": { "type": "cone", "angle": 60, "radius": 0.05 },
      "lifetime": { "type": "random", "min": 0.25, "max": 0.55 },
      "speed": { "type": "random", "min": 0.8, "max": 2.2 },
      "size": { "type": "random", "min": 0.03, "max": 0.07 },
      "startColor": [0.75, 0.88, 1, 0.7],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 0.3 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0.8 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/circle_02.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "mist",
      "position": [0, 1.4, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 60,
      "simulationSpace": "world",
      "emission": { "rateOverTime": 14 },
      "shape": { "type": "sphere", "radius": 0.5 },
      "lifetime": { "type": "random", "min": 1, "max": 2 },
      "speed": { "type": "random", "min": 0.2, "max": 0.6 },
      "size": { "type": "random", "min": 0.5, "max": 1 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "startColor": [0.8, 0.9, 1, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.6 }, { "t": 1, "v": 1.5 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.3, "alpha": 0.16 }, { "t": 1, "alpha": 0 }]
          }
        },
        "drag": { "coefficient": 1 }
      },
      "render": { "sprite": "../sprites/smoke_01.png", "blend": "alpha", "mode": "billboard" }
    }
  ]
}
