{
  "version": 1,
  "name": "Maelstrom",
  "looping": true,
  "emitters": [
    {
      "name": "core glow",
      "position": [0, 1.8, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 4,
      "emission": { "rateOverTime": 2 },
      "shape": { "type": "point" },
      "lifetime": 1.7,
      "speed": 0,
      "size": 3,
      "startColor": [1, 0.6, 0.3, 0.45],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.9 }, { "t": 0.5, "v": 1 }, { "t": 1, "v": 0.9 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.4, "alpha": 1 }, { "t": 0.6, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/light_02.png", "blend": "screen", "mode": "billboard" }
    },
    {
      "name": "swarm",
      "simulation": "gpu",
      "position": [0, 1.8, 0],
      "duration": 5,
      "looping": true,
      "maxParticles": 200000,
      "emission": { "rateOverTime": 45000 },
      "shape": { "type": "sphere", "radius": 3, "shell": true },
      "lifetime": { "type": "random", "min": 2.5, "max": 3.5 },
      "speed": { "type": "random", "min": 0.1, "max": 0.3 },
      "size": { "type": "random", "min": 0.02, "max": 0.055 },
      "startColor": {
        "type": "gradient",
        "gradient": {
          "colorKeys": [
            { "t": 0, "color": [1, 0.85, 0.45] },
            { "t": 0.5, "color": [1, 0.55, 0.25] },
            { "t": 1, "color": [0.9, 0.3, 0.15] }
          ],
          "alphaKeys": [{ "t": 0, "alpha": 1 }]
        }
      },
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.4 }, { "t": 0.3, "v": 1 }, { "t": 1, "v": 0.55 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.15, "alpha": 0.85 }, { "t": 0.85, "alpha": 0.85 }, { "t": 1, "alpha": 0 }]
          }
        },
        "vortex": { "strength": 150, "axis": [0, 1, 0], "radialPull": 0.4 },
        "attractor": { "strength": 1.1, "radius": 5 },
        "turbulence": { "strength": 0.7, "frequency": 0.45, "scrollSpeed": 0.35 },
        "drag": { "coefficient": 0.45 }
      },
      "render": { "sprite": "../sprites/circle_05.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "core surge",
      "simulation": "gpu",
      "position": [0, 1.8, 0],
      "duration": 5,
      "looping": true,
      "maxParticles": 40000,
      "emission": { "rateOverTime": 15000 },
      "shape": { "type": "point" },
      "lifetime": { "type": "random", "min": 0.9, "max": 1.6 },
      "speed": { "type": "random", "min": 1.2, "max": 2.4 },
      "size": { "type": "random", "min": 0.015, "max": 0.04 },
      "startColor": {
        "type": "randomColor",
        "a": [1, 0.95, 0.8, 1],
        "b": [1, 0.7, 0.4, 1]
      },
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 0 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        },
        "vortex": { "strength": 220, "axis": [0, 1, 0] },
        "drag": { "coefficient": 1.6 }
      },
      "render": { "sprite": "../sprites/circle_05.png", "blend": "additive", "mode": "billboard" }
    }
  ]
}
