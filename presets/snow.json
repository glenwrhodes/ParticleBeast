{
  "version": 1,
  "name": "Snowfall",
  "looping": true,
  "emitters": [
    {
      "name": "flakes",
      "position": [0, 7, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 900,
      "simulationSpace": "world",
      "emission": { "rateOverTime": 70 },
      "shape": { "type": "box", "size": [14, 0.1, 14] },
      "lifetime": 11,
      "speed": 0,
      "size": { "type": "random", "min": 0.05, "max": 0.13 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "angularVelocity": { "type": "random", "min": -40, "max": 40 },
      "startColor": [1, 1, 1, 0.9],
      "modules": {
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.05, "alpha": 0.9 }, { "t": 0.93, "alpha": 0.9 }, { "t": 1, "alpha": 0 }]
          }
        },
        "velocityOverLife": { "y": { "type": "random", "min": -0.85, "max": -0.55 } },
        "turbulence": { "strength": 0.55, "frequency": 0.35, "scrollSpeed": 0.25 },
        "limitVelocity": { "speed": 1.6, "dampen": 0.6 }
      },
      "render": { "sprite": "../sprites/circle_03.png", "blend": "alpha", "mode": "billboard" }
    },
    {
      "name": "near sparkle",
      "position": [0, 6, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 120,
      "simulationSpace": "world",
      "emission": { "rateOverTime": 9 },
      "shape": { "type": "box", "size": [10, 0.1, 10] },
      "lifetime": 9,
      "speed": 0,
      "size": { "type": "random", "min": 0.06, "max": 0.1 },
      "startColor": [0.92, 0.97, 1, 1],
      "modules": {
        "sizeOverLife": {
          "curve": { "keys": [{ "t": 0, "v": 0.4 }, { "t": 0.3, "v": 1 }, { "t": 0.5, "v": 0.4 }, { "t": 0.7, "v": 1 }, { "t": 1, "v": 0.3 }] }
        },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 1, 1] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.08, "alpha": 1 }, { "t": 0.92, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        },
        "velocityOverLife": { "y": { "type": "random", "min": -0.75, "max": -0.5 } },
        "turbulence": { "strength": 0.4, "frequency": 0.4, "scrollSpeed": 0.3 }
      },
      "render": { "sprite": "../sprites/star_06.png", "blend": "additive", "mode": "billboard" }
    }
  ]
}
