{
  "version": 1,
  "name": "Campfire",
  "looping": true,
  "emitters": [
    {
      "name": "core",
      "duration": 1,
      "looping": true,
      "maxParticles": 60,
      "emission": { "rateOverTime": 34 },
      "shape": { "type": "circle", "radius": 0.18 },
      "lifetime": { "type": "random", "min": 0.28, "max": 0.5 },
      "speed": { "type": "random", "min": 0.1, "max": 0.3 },
      "size": { "type": "random", "min": 0.55, "max": 0.8 },
      "sizeY": { "type": "random", "min": 0.8, "max": 1.15 },
      "startColor": [1, 1, 1, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.55 }, { "t": 0.35, "v": 1 }, { "t": 1, "v": 0.35 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [
              { "t": 0, "color": [1, 0.95, 0.7] },
              { "t": 0.5, "color": [1, 0.68, 0.2] },
              { "t": 1, "color": [1, 0.4, 0.08] }
            ],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.18, "alpha": 0.85 }, { "t": 0.75, "alpha": 0.6 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/fire_02.png", "blend": "additive", "mode": "vertical" }
    },
    {
      "name": "licks",
      "duration": 1,
      "looping": true,
      "maxParticles": 60,
      "emission": { "rateOverTime": 24 },
      "shape": { "type": "circle", "radius": 0.2 },
      "lifetime": { "type": "random", "min": 0.45, "max": 0.8 },
      "speed": { "type": "random", "min": 0.2, "max": 0.45 },
      "size": { "type": "random", "min": 0.24, "max": 0.42 },
      "sizeY": { "type": "random", "min": 0.6, "max": 1.05 },
      "startColor": [1, 1, 1, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.45 }, { "t": 0.3, "v": 1 }, { "t": 0.75, "v": 0.55 }, { "t": 1, "v": 0 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [
              { "t": 0, "color": [1, 0.9, 0.55] },
              { "t": 0.45, "color": [1, 0.6, 0.15] },
              { "t": 1, "color": [0.85, 0.3, 0.05] }
            ],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.15, "alpha": 1 }, { "t": 0.7, "alpha": 0.75 }, { "t": 1, "alpha": 0 }]
          }
        },
        "velocityOverLife": { "y": { "type": "curve", "keys": [{ "t": 0, "v": 0.15 }, { "t": 1, "v": 0.7 }] } },
        "turbulence": { "strength": 0.18, "frequency": 2.2, "scrollSpeed": 1.1 }
      },
      "render": { "sprite": "../sprites/flame_05.png", "blend": "additive", "mode": "vertical" }
    },
    {
      "name": "glow",
      "position": [0, 0.3, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 6,
      "emission": { "rateOverTime": 3 },
      "shape": { "type": "point" },
      "lifetime": 1.4,
      "speed": 0,
      "size": { "type": "random", "min": 1.3, "max": 1.6 },
      "startColor": [1, 0.55, 0.15, 0.22],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.85 }, { "t": 0.5, "v": 1 }, { "t": 1, "v": 0.85 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 0.6, 0.2] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.3, "alpha": 1 }, { "t": 0.7, "alpha": 1 }, { "t": 1, "alpha": 0 }]
          }
        }
      },
      "render": { "sprite": "../sprites/light_01.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "embers",
      "duration": 1,
      "looping": true,
      "maxParticles": 60,
      "emission": { "rateOverTime": 10 },
      "shape": { "type": "circle", "radius": 0.24 },
      "lifetime": { "type": "random", "min": 1.2, "max": 2.6 },
      "speed": { "type": "random", "min": 0.3, "max": 0.7 },
      "size": { "type": "random", "min": 0.03, "max": 0.08 },
      "startColor": [1, 0.7, 0.25, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 1 }, { "t": 1, "v": 0 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [1, 0.85, 0.45] }, { "t": 1, "color": [1, 0.3, 0.06] }],
            "alphaKeys": [{ "t": 0, "alpha": 1 }, { "t": 0.7, "alpha": 0.9 }, { "t": 1, "alpha": 0 }]
          }
        },
        "velocityOverLife": { "y": { "type": "curve", "keys": [{ "t": 0, "v": 0.5 }, { "t": 1, "v": 1.5 }] } },
        "turbulence": { "strength": 0.9, "frequency": 1.3, "scrollSpeed": 0.9 }
      },
      "render": { "sprite": "../sprites/circle_05.png", "blend": "additive", "mode": "billboard" }
    },
    {
      "name": "smoke",
      "position": [0, 0.85, 0],
      "duration": 1,
      "looping": true,
      "maxParticles": 50,
      "simulationSpace": "world",
      "emission": { "rateOverTime": 9 },
      "shape": { "type": "circle", "radius": 0.18 },
      "lifetime": { "type": "random", "min": 2, "max": 3.4 },
      "speed": { "type": "random", "min": 0.2, "max": 0.5 },
      "size": { "type": "random", "min": 0.5, "max": 0.85 },
      "startRotation": { "type": "random", "min": 0, "max": 360 },
      "angularVelocity": { "type": "random", "min": -25, "max": 25 },
      "startColor": [1, 1, 1, 1],
      "modules": {
        "sizeOverLife": { "curve": { "keys": [{ "t": 0, "v": 0.5 }, { "t": 1, "v": 2.1 }] } },
        "colorOverLife": {
          "gradient": {
            "colorKeys": [{ "t": 0, "color": [0.4, 0.38, 0.36] }, { "t": 1, "color": [0.25, 0.25, 0.27] }],
            "alphaKeys": [{ "t": 0, "alpha": 0 }, { "t": 0.2, "alpha": 0.35 }, { "t": 1, "alpha": 0 }]
          }
        },
        "velocityOverLife": { "y": { "type": "curve", "keys": [{ "t": 0, "v": 0.6 }, { "t": 1, "v": 1.1 }] } },
        "turbulence": { "strength": 0.35, "frequency": 0.55, "scrollSpeed": 0.35 }
      },
      "render": { "sprite": "../sprites/smoke_04.png", "blend": "alpha", "mode": "billboard", "applyTint": false }
    }
  ]
}
