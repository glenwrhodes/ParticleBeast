{
  "name": "particle-beast",
  "version": "0.1.0",
  "description": "Zero-dependency WebGL2 particle engine with a visual editor and JSON presets",
  "type": "module",
  "license": "MIT",
  "main": "dist/lib/particle-beast.umd.cjs",
  "module": "dist/lib/particle-beast.js",
  "types": "dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/particle-beast.js",
      "require": "./dist/lib/particle-beast.umd.cjs"
    },
    "./three": {
      "types": "./dist/lib/types/three/index.d.ts",
      "import": "./dist/lib/particle-beast-three.js",
      "require": "./dist/lib/particle-beast-three.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.ts && vite build --config vite.lib.three.config.ts && tsc -p tsconfig.lib.json && node scripts/postbuild.mjs",
    "lint": "eslint . && tsc --noEmit",
    "start": "node server.js",
    "heroku-postbuild": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/three": "^0.184.1",
    "eslint": "^9.17.0",
    "jszip": "^3.10.1",
    "three": "^0.184.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5"
  }
}
