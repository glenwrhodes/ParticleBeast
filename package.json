{
  "name": "particle-beast",
  "version": "0.1.0",
  "description": "Zero-dependency WebGL2 particle engine with a visual editor and JSON presets",
  "type": "module",
  "license": "MIT",
  "main": "dist/lib/particle-beast.umd.cjs",
  "module": "dist/lib/particle-beast.js",
  "types": "dist/lib/types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/postbuild.mjs",
    "lint": "eslint . && tsc --noEmit",
    "start": "node server.js",
    "heroku-postbuild": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "jszip": "^3.10.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5"
  }
}
